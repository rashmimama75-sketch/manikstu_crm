# Copy to .env.local for local development.

# Backend wiring -----------------------------------------------------------
# When set, the app's /api/* routes proxy to the Laravel CRM backend and auth
# runs against its Sanctum tokens. Leave it unset to run on the built-in
# sample data (offline demo) with no backend.
CRM_API_BASE=http://127.0.0.1:8000/api

# Secret for signing the session cookie. Required in production; in dev a
# built-in fallback is used if this is omitted.
AUTH_SECRET=change-me
